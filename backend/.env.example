# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://mynaira:mynaira@localhost:5432/mynairatrack
JWT_SECRET=change-me-to-a-random-local-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
FX_PROVIDER=open-er-api
FX_BASE_URL=https://open.er-api.com/v6/latest
FX_API_KEY=
# Resend (transactional email: verification, password reset, alerts).
# Empty = email sending disabled; app works normally without it.
# Get a key at https://resend.com/api-keys and put it in local .env only.
RESEND_API_KEY=
RESEND_FROM=MYNAIRATRACK <onboarding@resend.dev>
# Public URL of the frontend, used to build email links.
FRONTEND_URL=http://localhost:5173
# Africa's Talking SMS (optional; mock mode when empty = free, logs only).
# Sandbox is free for simulator testing; live delivery is pay-as-you-go.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SANDBOX=true
# SMTP fallback for email (free Gmail App Password delivers to anyone,
# no custom domain needed). Used only when RESEND_API_KEY is empty.
# NOTE: some free hosts block outbound SMTP — prefer Brevo below there.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Brevo (free tier, single verified sender needs no domain).
# HTTP API: works everywhere, including hosts that block SMTP.
BREVO_API_KEY=
BREVO_SENDER=
